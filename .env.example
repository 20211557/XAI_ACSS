# =============================================================================
# 환경 변수 템플릿 - 복사해서 사용:  cp .env.example .env
# .env 가 없어도 docker compose 는 아래 기본값으로 동작한다.
# 컨테이너 내부 서비스 주소(API_URL, MLFLOW_TRACKING_URI)는 docker-compose.yml 이 덮어쓴다.
# =============================================================================

# ----- 공통 -----
APP_ENV=local
LOG_LEVEL=INFO

# Docker 이미지의 Python 버전
PYTHON_VERSION=3.10

# ----- 호스트 포트 -----
API_PORT=8000
DASHBOARD_PORT=8501
MLFLOW_PORT=5000
JUPYTER_PORT=8888

# ----- 서비스 주소 (호스트에서 직접 실행할 때 사용) -----
API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=xai-credit-scoring

# ----- 모델: models/{MODEL_NAME}_{MODEL_VERSION}.pkl 을 로드 -----
MODEL_NAME=xgboost
MODEL_VERSION=v1.0

# ----- 경로 (프로젝트 루트 기준 상대 경로) -----
MODEL_DIR=models
DATA_DIR=data
REPORTS_DIR=reports
CONFIG_PATH=configs/config.yaml

# ----- Kaggle API (Give Me Some Credit 다운로드용, https://www.kaggle.com/settings 에서 발급) -----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ----- JupyterLab (dev 프로필) 접속 토큰 -----
JUPYTER_TOKEN=change-me
