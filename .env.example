# =============================================================================
# 환경 변수 템플릿 - 복사해서 사용:  cp .env.example .env   (.env 는 절대 커밋하지 않는다)
# .env 가 없어도 docker compose 는 아래 기본값으로 동작한다.
# 컨테이너 내부 서비스 주소(API_URL, MLFLOW_TRACKING_URI)는 docker-compose.yml 이 덮어쓴다.
# =============================================================================

# ----- 공통 -----
APP_ENV=local
LOG_LEVEL=INFO

# Docker 이미지의 Python 버전 (xgboost 3.4 · 학습된 모델 때문에 3.12 이상)
PYTHON_VERSION=3.12

# ----- 호스트 포트 -----
API_PORT=8000
DASHBOARD_PORT=8501
MLFLOW_PORT=5000
JUPYTER_PORT=8888

# ----- 서비스 주소 (호스트에서 직접 실행할 때 사용) -----
API_URL=http://localhost:8000

# MLflow 기록 위치. 실험 이름은 configs/train.yaml 의 mlflow.experiments (알고리즘별 + final + audit)
#   http://... : MLflow 서버 (docker compose 의 mlflow 서비스, 컨테이너 안에서는 http://mlflow:5000)
#   폴더 경로 또는 미설정 : 로컬 SQLite 저장소 ./mlruns (예: MLFLOW_TRACKING_URI=./mlruns)
# 학습 스크립트(src/models/train.py)는 .env 파일이 아니라 셸 환경 변수를 읽는다.
# 호스트에서 서버로 기록하려면 export MLFLOW_TRACKING_URI=http://localhost:5000 후 학습한다.
MLFLOW_TRACKING_URI=http://localhost:5000

# ----- 모델: models/{MODEL_NAME}_{MODEL_VERSION}.joblib 을 로드 -----
# 파일은 python -m src.models.train 이 만든다 (버전은 configs/train.yaml 의 model_version)
MODEL_NAME=xgboost
MODEL_VERSION=v1.0

# ----- 경로 (프로젝트 루트 기준 상대 경로) -----
MODEL_DIR=models
DATA_DIR=data
REPORTS_DIR=reports
CONFIG_PATH=configs/config.yaml

# ----- 테스트: 1 이면 데이터 파일이 없을 때 해당 테스트를 건너뛰지 않고 실패시킨다 (tests/helpers.py) -----
REQUIRE_DATA=0

# ----- Kaggle API (Give Me Some Credit 다운로드용, https://www.kaggle.com/settings 에서 발급) -----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ----- JupyterLab (dev 프로필) 접속 토큰 -----
JUPYTER_TOKEN=change-me
